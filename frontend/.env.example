# Copy to .env for local dev. In production, set these as build
# environment variables in Cloudflare Pages (see DEPLOY.md).

# Blank = use the backend's demo payments.
VITE_STRIPE_PUBLISHABLE_KEY=
# false = Apple Pay / Google Pay only (strongest card-testing defence, but
# desktop visitors without a wallet can't buy)
VITE_ALLOW_CARDS=true
# Blank in dev (Vite proxies /api). In production: https://api.yourdomain.com
VITE_API_URL=
# Production only: your Supabase project URL, so the CSP allows ad images from it.
VITE_MEDIA_ORIGIN=
# Cloudflare Turnstile site key (bot check in the bid form). Blank = off.
VITE_TURNSTILE_SITE_KEY=
# Google Maps Embed API key for the map add-on (free, unlimited). In Google
# Cloud: enable "Maps Embed API", then restrict the key to your domain(s).
# Blank = paid maps show an "Open in Google Maps" button instead.
VITE_GOOGLE_MAPS_EMBED_KEY=
# Official social accounts (full https:// profile URLs). Only the ones you set
# appear in the "Official" row on the home page and in the footer.
VITE_SOCIAL_X=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_FACEBOOK=
