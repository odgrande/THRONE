# Copy to .env. Every integration is optional in development:
# leave a key blank and the backend falls back to a local/demo implementation.
# NODE_ENV=production refuses to start unless all of them are set
# (DEPLOY_ENV=staging relaxes that for a test deploy with demo payments).

PORT=5000
CORS_ORIGIN=http://localhost:5173
# Public base URL of this backend (used for local-disk media URLs)
PUBLIC_URL=http://localhost:5000
# The public website (printed in hype videos)
SITE_URL=http://localhost:5173
# Supabase Storage bucket for images/videos (used when SUPABASE_URL is set)
STORAGE_BUCKET=media
# Secret header Cloudflare adds to every request (see DEPLOY.md step 6). Blank = off.
ORIGIN_SECRET=
# Reverse proxies in front of the app (Cloudflare -> host load balancer = 2)
TRUST_PROXY=0
# Per-IP bid submissions per minute
BIDS_PER_MINUTE=6

# --- Game rules ---
# Prices are per region, in minor units (cents for global USD, kobo for ng NGN).
# Global uses the plain names; Nigeria uses the same names prefixed NG_.
# Defaults: global $5 start / $2 raise; ng ₦2,000 start / ₦500 raise.
STARTING_PRICE_CENTS=500
MIN_INCREMENT_CENTS=200
# NG_STARTING_PRICE_CENTS=200000
# NG_MIN_INCREMENT_CENTS=50000
# Shared mechanics (all regions)
MIN_RAISE_PCT=10
# Shield = base + SECONDS_PER_STEP for every SHIELD_STEP_CENTS above the start, capped
SHIELD_BASE_SECONDS=60
SHIELD_STEP_CENTS=100
SHIELD_SECONDS_PER_STEP=30
# NG_SHIELD_STEP_CENTS=10000
SHIELD_MAX_SECONDS=1800
# Minimum % needed to overthrow a shielded king
SHIELD_PREMIUM_PCT=25
# Term limit: an unchallenged king retires after this long (7 days)
THRONE_TERM_SECONDS=604800

# --- Smaller boards: fixed-price bookings (1 / 3 / 7 days; 3 days = 2.5x, 7 days = 5x) ---
BOARD2_NAME=Prince Board
BOARD2_DAY_CENTS=300
BOARD3_NAME=Herald Board
BOARD3_DAY_CENTS=150
MAX_BOOKING_AHEAD_DAYS=60
# Relegation: a dethroned king moves the same ad to Board 2 for 1 day at this discount
RELEGATION_DISCOUNT_PCT=50
RELEGATION_WINDOW_HOURS=24
# Dethroned ads show free in the "Recently dethroned" strip this long
RECENTLY_DETHRONED_HOURS=24
# Map add-on (business address map), charged on top of the ad price
MAP_ADDON_CENTS=200
# NG_MAP_ADDON_CENTS=100000
# Video ads: add-on on top of the price (Throne, Court, Spotlight). Every video
# is reviewed by a person in /admin before it goes live.
VIDEO_ADDON_CENTS=500
# NG_VIDEO_ADDON_CENTS=200000
# The Spotlight (10 featured spaces) and the Market (12 low-cost stalls), per day
SPOTLIGHT_DAY_CENTS=100
MARKET_DAY_CENTS=50
# NG_SPOTLIGHT_DAY_CENTS=50000
# NG_MARKET_DAY_CENTS=30000

# --- King of the Day ---
# Round length and the UTC hour it ends (86400 + 0 = crowned daily at midnight UTC)
CROWN_ROUND_SECONDS=86400
CROWN_CUTOFF_HOUR_UTC=0
# Overtime: a takeover in the final window adds time, up to the cap
CROWN_OVERTIME_WINDOW_SECONDS=60
CROWN_EXTENSION_SECONDS=12
CROWN_MAX_OVERTIME_SECONDS=600

# --- Hype videos ---
# Only takeovers at or above this amount get a video
HYPE_MIN_CENTS=2000
# inline = render inside the API process (dev). In production leave blank
# and run `npm run worker` as a separate process.
HYPE_WORKER=

# --- Payments ---
# Processor per region: stripe | paystack | demo. Defaults: global = stripe if
# STRIPE_SECRET_KEY is set (else demo); ng = paystack if PAYSTACK_SECRET_KEY is
# set (else demo). Global can use Paystack in USD once Paystack enables USD for
# your account: PAYMENTS_GLOBAL=paystack.
PAYMENTS_GLOBAL=flutterwave
PAYMENTS_NG=
# Paystack (Nigeria). Use the TEST secret key (sk_test_...) until launch. The
# same key verifies webhook signatures. Webhook URL: https://<api>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Flutterwave (Global edition, USD): Flutterwave Standard, the hosted
# checkout (v3 API). Secret key = FLWSECK_TEST-... in test, FLWSECK-... live.
# Webhook: Flutterwave dashboard -> Settings -> Webhooks: URL
# https://<api>/api/webhooks/flutterwave, and set a "Secret hash" (any long
# random string) -> put the same value in FLUTTERWAVE_WEBHOOK_HASH.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Stripe (global alternative, if your business can use it)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# automatic | any  (any = always run 3D Secure on typed-in cards)
STRIPE_3DS=automatic

# --- Persistence (blank = in-memory store, resets on restart) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Reports ---
# Distinct reporters needed to auto-hide a live ad pending review (0 = never)
REPORT_AUTOHIDE_THRESHOLD=5
# Salt for hashing reporter IPs; also signs video upload tokens. REQUIRED on any
# deploy (16+ random characters; the Render blueprints generate it).
IP_HASH_SALT=

# --- Admin health view (/admin). Blank = disabled. Generate: openssl rand -hex 32 ---
ADMIN_TOKEN=

# --- Safety (blank = checks OFF, dev only) ---
OPENAI_API_KEY=
# Google Cloud Web Risk API key (malware / phishing link checks)
WEB_RISK_API_KEY=
# Cloudflare Turnstile secret (bot check in the bid form)
TURNSTILE_SECRET_KEY=
