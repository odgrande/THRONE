# Takeover video worker (Remotion). Render's plain Node runtime lacks the
# system libraries headless Chrome needs, so the worker ships as an image.
FROM node:22-bookworm-slim

# Shared libraries for Remotion's Chrome Headless Shell (per Remotion's Linux docs).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libnss3 libdbus-1-3 libatk1.0-0 libgbm-dev libasound2 libxrandr2 \
      libxkbcommon-dev libxfixes3 libxcomposite1 libxdamage1 libatk-bridge2.0-0 \
      libpango-1.0-0 libcairo2 libcups2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# Download the headless browser at build time, not on the first job.
RUN node --input-type=module -e "import { ensureBrowser } from '@remotion/renderer'; await ensureBrowser();"

COPY src ./src

# Run as the unprivileged user that ships with the node image.
USER node
CMD ["node", "src/workers/videoWorker.js"]
